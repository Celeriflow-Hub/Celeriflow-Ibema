  culturaProjects    CulturaProjeto[]    @relation("CulturaProjectBudget")
  culturaFunds       CulturaFundo[]      @relation("CulturaFundBudget")

  @@index([annualBudgetExpenseFixationId])
  @@index([programPPAId, actionPPAId])
}

enum RevenueStage {
  LANCADA
  ARRECADADA
  ESTORNADA
}

enum RevenueClassification {
  ORCAMENTARIA
  INTRAORCAMENTARIA
  REDUTORA
}

model Revenue {
  id                      String                          @id @default(cuid())
  date                    DateTime                        @default(now())
  value                   Float
  valueDecimal            Decimal?                        @db.Decimal(18, 2)
  financialYearId         String?
  financialYear           FinancialYear?                  @relation(fields: [financialYearId], references: [id])
  revenueNatureId         String
  revenueNature           RevenueNature                   @relation(fields: [revenueNatureId], references: [id])
  resourceSourceId        String
  resourceSource          ResourceSource                  @relation(fields: [resourceSourceId], references: [id])
  bankAccountId           String?
  bankAccount             BankAccount?                    @relation(fields: [bankAccountId], references: [id])
  secretariatId           String?
  secretariat             Secretariat?                    @relation("SecretariatRevenues", fields: [secretariatId], references: [id])
  status                  String                          @default("Arrecadada")
  stage                   RevenueStage                    @default(ARRECADADA)
  classification          RevenueClassification           @default(ORCAMENTARIA)
  launchDate              DateTime?
  collectionDate          DateTime?
  reversedAt              DateTime?
  history                 String?
  sourceModule            String                          @default("MANUAL")
  sourceType              String                          @default("REVENUE")
  sourceId                String?
  eventType               String                          @default("REVENUE_CONFIRMED")
  idempotencyKey          String?                         @unique
  integrationEventId      String?
  bankTransactionId       String?
  bankAccountExternalId   String?
  collectionReference     String?
  treasuryMovement        TreasuryMovement?
  taxIntegration          TaxRevenueIntegrationEvent?
  reversal                RevenueReversal?
  resourceRedistributions RevenueResourceRedistribution[]
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt

  @@index([financialYearId, stage, date])
  @@index([resourceSourceId, stage])
  @@index([bankTransactionId])
  @@index([integrationEventId])
}

model Expense {
  id              String              @id @default(cuid())
  date            DateTime            @default(now())
  description     String
  value           Float
  valueDecimal    Decimal?            @db.Decimal(18, 2)
  appropriationId String
  appropriation   BudgetAppropriation @relation(fields: [appropriationId], references: [id])
  secretariatId   String
  secretariat     Secretariat         @relation("SecretariatExpenses", fields: [secretariatId], references: [id])
  supplierId      String?
  supplier        Supplier?           @relation("SupplierExpenses", fields: [supplierId], references: [id])
  requestedById   String?
  requestedBy     Usuario?            @relation("ExpenseRequestedBy", fields: [requestedById], references: [id])
  approvedById    String?
  approvedBy      Usuario?            @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  status          String              @default("Solicitada") // Solicitada, Aprovada, Rejeitada, Reservada, Empenhada
  sourceModule    String              @default("MANUAL")
  sourceType      String              @default("EXPENSE_REQUEST")
  sourceId        String?
  eventType       String              @default("EXPENSE_REQUEST")
  idempotencyKey  String?             @unique

  purchaseReceiptId String?          @unique
  purchaseReceipt   PurchaseReceipt? @relation("PurchaseReceiptExpense", fields: [purchaseReceiptId], references: [id], onDelete: Restrict)

  socialProgramId String?
  socialProgram   SocialProgram? @relation(fields: [socialProgramId], references: [id])

  socialBenefitId String?
  socialBenefit   SocialBenefit? @relation(fields: [socialBenefitId], references: [id])

  reservations BudgetReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BudgetReservation {
  id              String              @id @default(cuid())
  number          String              @unique
  date            DateTime            @default(now())
  value           Float
  valueDecimal    Decimal?            @db.Decimal(18, 2)
  appropriationId String
  appropriation   BudgetAppropriation @relation(fields: [appropriationId], references: [id])
  expenseId       String?
  expense         Expense?            @relation(fields: [expenseId], references: [id])
  justification   String?
  status          String              @default("Ativa") // Ativa, Cancelada, Empenhada
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  commitment Commitment?
}

model BudgetMovement {
  id              String              @id @default(cuid())
  date            DateTime            @default(now())
  type            String
  valueDecimal    Decimal             @db.Decimal(18, 2)
  justification   String
  appropriationId String
  appropriation   BudgetAppropriation @relation(fields: [appropriationId], references: [id])
  sourceModule    String              @default("MANUAL")
  sourceType      String              @default("BUDGET_MOVEMENT")
  sourceId        String?
  eventType       String              @default("BUDGET_MOVEMENT")
  idempotencyKey  String?             @unique
  createdAt       DateTime            @default(now())
}

model Creditor {
  id                  String               @id @default(cuid())
  type                String               @default("Fornecedor")
  name                String
  document            String?              @unique
  status              String               @default("Ativo")
  personId            String?              @unique
  person              Person?              @relation(fields: [personId], references: [id])
  companyId           String?              @unique
  company             Company?             @relation(fields: [companyId], references: [id])
  supplierId          String?              @unique
  supplier            Supplier?            @relation("SupplierCreditor", fields: [supplierId], references: [id])
  commitments         Commitment[]
  payments            Payment[]
  withholdingPayables WithholdingPayable[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Commitment {
  id                    String              @id @default(cuid())
  number                String              @unique
  date                  DateTime            @default(now())
  value                 Float
  valueDecimal          Decimal?            @db.Decimal(18, 2)
  type                  String              @default("OrdinÃ¡rio") // OrdinÃ¡rio, Estimativo, Global
  history               String
  appropriationId       String
  appropriation         BudgetAppropriation @relation(fields: [appropriationId], references: [id])
  supplierId            String
  supplier              Supplier            @relation("SupplierCommitments", fields: [supplierId], references: [id])
  creditorId            String?
  creditor              Creditor?           @relation(fields: [creditorId], references: [id])
  processId             String?
  process               Process?            @relation("FinancialCommitmentProcess", fields: [processId], references: [id])
  contractId            String?
  contract              Contract?           @relation("FinancialCommitmentContract", fields: [contractId], references: [id])
  purchaseProcessId     String?
  purchaseProcess       PurchaseProcess?    @relation("ProcurementProcessCommitments", fields: [purchaseProcessId], references: [id], onDelete: Restrict)
  purchaseReceiptId     String?             @unique
  purchaseReceipt       PurchaseReceipt?    @relation("PurchaseReceiptCommitment", fields: [purchaseReceiptId], references: [id], onDelete: Restrict)
  covenantId            String?
  covenant              Covenant?           @relation("CovenantCommitments", fields: [covenantId], references: [id])
  publicityCampaignId   String?
  publicityCampaign     PublicityCampaign?  @relation("PublicityCampaignCommitments", fields: [publicityCampaignId], references: [id])
  fundedDebtId          String?
  fundedDebt            FundedDebt?         @relation("FundedDebtCommitments", fields: [fundedDebtId], references: [id])
  covenantNumber        String?
  publicityCampaignName String?
  fundedDebtName        String?
  reservationId         String?             @unique
  reservation           BudgetReservation?  @relation(fields: [reservationId], references: [id])
  status                String              @default("Emitido") // Emitido, Liquidado, Pago, Anulado
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  settlements          Settlement[]
  payments             Payment[]
  financialDocument    FinancialDocument?    @relation("FinancialDocumentCommitment")
  movements            CommitmentMovement[]
  obrasServices        ObrasServico[]        @relation("ObrasServicoCommitment")
  culturaProjects      CulturaProjeto[]      @relation("CulturaProjectCommitment")
  payableCarryForwards PayableCarryForward[]
}

model CommitmentMovement {
  id            String     @id @default(cuid())
  date          DateTime   @default(now())
  type          String // ReforÃ§o, AnulaÃ§Ã£o
  valueDecimal  Decimal    @db.Decimal(18, 2)
  justification String
  commitmentId  String
  commitment    Commitment @relation(fields: [commitmentId], references: [id])
  createdAt     DateTime   @default(now())

  @@index([commitmentId, date])
}

model Settlement {
  id                      String     @id @default(cuid())
  date                    DateTime   @default(now())
  value                   Float
  valueDecimal            Decimal?   @db.Decimal(18, 2)
  documentRef             String? // NF, Recibo, etc
  fiscalDocumentNumber    String?
  fiscalDocumentSeries    String?
  fiscalDocumentIssueDate DateTime?
  fiscalDocumentAccessKey String?    @unique
  documentId              String?
  document                Document?  @relation("SettlementDocument", fields: [documentId], references: [id])
  commitmentId            String
  commitment              Commitment @relation(fields: [commitmentId], references: [id])
  authorId                String
  author                  Employee   @relation("SettlementAuthor", fields: [authorId], references: [id])
  status                  String     @default("Liquidado") // Liquidado, Cancelado
  notes                   String?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  payments          Payment[]
  retentions        SettlementRetention[]
  financialDocument FinancialDocument?    @relation("FinancialDocumentSettlement")
  materialMovements MaterialMovement[]    @relation("SettlementMaterialMovements")

  @@index([documentId])
  @@index([fiscalDocumentNumber, fiscalDocumentSeries])
}

model Payment {
  id                     String      @id @default(cuid())
  orderNumber            String      @unique
  date                   DateTime    @default(now())
  value                  Float
  valueDecimal           Decimal?    @db.Decimal(18, 2)
  commitmentId           String
  commitment             Commitment  @relation(fields: [commitmentId], references: [id])
  settlementId           String?
  settlement             Settlement? @relation(fields: [settlementId], references: [id])
  bankAccountId          String
  bankAccount            BankAccount @relation(fields: [bankAccountId], references: [id])
  supplierId             String
  supplier               Supplier    @relation("SupplierPayments", fields: [supplierId], references: [id])
  creditorId             String?
  creditor               Creditor?   @relation(fields: [creditorId], references: [id])
  isExceptional          Boolean     @default(false)
  exceptionJustification String?
  netValueDecimal        Decimal?    @db.Decimal(18, 2)
  paymentMethod          String      @default("TransferÃªncia")
  status                 String      @default("Pago") // Pago, Cancelado
  paymentOrderExternalId String?     @unique
  integrationEventId      String?     @unique
  bankAccountExternalId   String?
  bankTransactionId       String?     @unique
  bankStatus              String?     @default("PENDING_SUBMISSION")
  bankSubmittedAt         DateTime?
  bankProcessedAt         DateTime?
  bankRejectionCode       String?
  bankRejectionMessage    String?
  reversalOfBankTransactionId String?
  reversalBankTransactionId   String?     @unique
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([bankAccountExternalId, bankStatus])

  retentions                PaymentRetention[]
  financialDocument         FinancialDocument?         @relation("FinancialDocumentPayment")
  payableCarryForwardEvents PayableCarryForwardEvent[]
}

// Registros internos emitidos pelo sistema; nÃ£o dependem de arquivo GED ou assinatura externa.
model FinancialDocument {
  id                   String   @id @default(cuid())
  documentType         String
  number               String   @unique
  title                String
  source               String   @default("SYSTEM")
  generatedByUsuarioId String
  snapshot             Json
  generatedAt          DateTime @default(now())

  commitmentId         String?
  commitment           Commitment?         @relation("FinancialDocumentCommitment", fields: [commitmentId], references: [id], onDelete: Restrict)
  settlementId         String?
  settlement           Settlement?         @relation("FinancialDocumentSettlement", fields: [settlementId], references: [id], onDelete: Restrict)
  paymentId            String?
  payment              Payment?            @relation("FinancialDocumentPayment", fields: [paymentId], references: [id], onDelete: Restrict)
  withholdingPayableId String?
  withholdingPayable   WithholdingPayable? @relation("FinancialDocumentWithholdingPayable", fields: [withholdingPayableId], references: [id], onDelete: Restrict)

  @@unique([commitmentId])
  @@unique([settlementId])
  @@unique([paymentId])
  @@unique([withholdingPayableId])
  @@index([documentType, generatedAt])
}

model PaymentRetention {
  id                    String               @id @default(cuid())
  paymentId             String
  payment               Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  settlementRetentionId String?
  settlementRetention   SettlementRetention? @relation(fields: [settlementRetentionId], references: [id], onDelete: Restrict)
  retentionRuleId       String?
  retentionRule         RetentionRule?       @relation(fields: [retentionRuleId], references: [id], onDelete: Restrict)
  type                  String
  description           String?
  valueDecimal          Decimal              @db.Decimal(18, 2)
  beneficiaryName       String
  beneficiaryDocument   String?
  withholdingPayable    WithholdingPayable?
  createdAt             DateTime             @default(now())

  @@index([paymentId])
  @@index([settlementRetentionId])
  @@index([retentionRuleId])
}

// RetenÃ§Ãµes sÃ£o apuradas no ateste da liquidaÃ§Ã£o. PaymentRetention registra apenas
// a parcela vinculada a cada ordem de pagamento e ao posterior recolhimento.
model SettlementRetention {
  id                     String        @id @default(cuid())
  settlementId           String
  settlement             Settlement    @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  retentionRuleId        String
  retentionRule          RetentionRule @relation(fields: [retentionRuleId], references: [id], onDelete: Restrict)
  type                   String
  description            String?
  calculationBaseDecimal Decimal       @db.Decimal(18, 2)
  ratePercentage         Decimal       @db.Decimal(7, 4)
  valueDecimal           Decimal       @db.Decimal(18, 2)
  beneficiaryName        String
  beneficiaryDocument    String?
  dueDate                DateTime?
  createdAt              DateTime      @default(now())

  paymentRetentions PaymentRetention[]

  @@unique([settlementId, retentionRuleId])
  @@index([retentionRuleId])
}

model RetentionRule {
  id                        String         @id @default(cuid())
  code                      String         @unique
  type                      String
  description               String
  calculationBasePercentage Decimal        @db.Decimal(7, 4)
  ratePercentage            Decimal        @db.Decimal(7, 4)
  beneficiaryName           String
  beneficiaryDocument       String?
  serviceCode               String?
  financialYearId           String?
  financialYear             FinancialYear? @relation(fields: [financialYearId], references: [id])
  effectiveFrom             DateTime
  effectiveTo               DateTime?
  dueDays                   Int?
  isActive                  Boolean        @default(true)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  paymentRetentions    PaymentRetention[]
  settlementRetentions SettlementRetention[]

  @@index([isActive, effectiveFrom, effectiveTo])
  @@index([financialYearId, serviceCode])
}

model WithholdingPayable {
  id                String             @id @default(cuid())
  retentionId       String             @unique
  retention         PaymentRetention   @relation(fields: [retentionId], references: [id], onDelete: Restrict)
  creditorId        String?
  creditor          Creditor?          @relation(fields: [creditorId], references: [id])
  receiptDocumentId String?
  receiptDocument   Document?          @relation("WithholdingReceiptDocument", fields: [receiptDocumentId], references: [id], onDelete: Restrict)
  dueDate           DateTime?
  valueDecimal      Decimal            @db.Decimal(18, 2)
  status            String             @default("Pendente") // Pendente, Recolhida, Cancelada
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  financialDocument FinancialDocument? @relation("FinancialDocumentWithholdingPayable")

  @@index([status, dueDate])
  @@index([receiptDocumentId])
}

model BankAccount {
  id                    String          @id @default(cuid())
