// Split Prisma schema: main schema.prisma contains the datasource and generator.
// The SAGRES Frota monthly models are deliberately isolated for maintainability.
// FleetSagresMonthUnit.unitId has a SQL-level FK to FleetUnit without changing
// the large legacy FleetUnit model or its reverse Prisma relation.

model FleetSagresMonth {
  id                String                     @id @default(cuid())
  competence        String                     @unique
  status            String                     @default("RASCUNHO")
  revision          Int                        @default(0)
  createdById       String
  certifiedById     String?
  certifiedAt       DateTime?
  certificationNote String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  units             FleetSagresMonthUnit[]
  revisions         FleetSagresMonthRevision[]
  events            FleetSagresMonthEvent[]
}

model FleetSagresMonthUnit {
  id            String                       @id @default(cuid())
  monthId       String
  month         FleetSagresMonth             @relation(fields: [monthId], references: [id], onDelete: Restrict)
  unitId        String // DB foreign key to FleetUnit(id) created by migration
  code          String
  plate         String?
  category      String
  fuelType      String?
  departmentId  String?
  evidenceRef   String
  createdById   String
  createdAt     DateTime                     @default(now())
  situations    FleetSagresMonthSituation[]

  @@unique([monthId, unitId])
  @@index([unitId, monthId])
}

model FleetSagresMonthSituation {
  id           String                @id @default(cuid())
  monthUnitId  String
  monthUnit    FleetSagresMonthUnit  @relation(fields: [monthUnitId], references: [id], onDelete: Restrict)
  date         DateTime              @db.Date
  status       String
  evidenceRef  String
  recordedById String
  recordedAt   DateTime              @default(now())

  @@unique([monthUnitId, date])
  @@index([date])
}

/** Immutable certified snapshots survive later corrections and reopening. */
model FleetSagresMonthRevision {
  id                String           @id @default(cuid())
  monthId           String
  month             FleetSagresMonth @relation(fields: [monthId], references: [id], onDelete: Restrict)
  version           Int
  payload           Json
  sha256            String
  certifiedById     String
  certificationNote String
  createdAt         DateTime         @default(now())

  @@unique([monthId, version])
}

/** Append-only application trail of each manual declaration operation. */
model FleetSagresMonthEvent {
  id        String           @id @default(cuid())
  monthId   String
  month     FleetSagresMonth @relation(fields: [monthId], references: [id], onDelete: Restrict)
  actorId   String
  action    String
  detail    Json
  createdAt DateTime         @default(now())

  @@index([monthId, createdAt])
}
