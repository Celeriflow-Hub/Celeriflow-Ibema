  budgetUnit            BudgetUnit?     @relation(fields: [budgetUnitId], references: [id])
  accountingPlanId      String?         @unique
  accountingPlan        AccountingPlan? @relation("BankAccountAccountingPlan", fields: [accountingPlanId], references: [id])
