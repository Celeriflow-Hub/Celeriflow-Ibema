// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id             String   @id @default(cuid())
  name           String
  role           String?
  organization   String
  city           String
  state          String
  email          String
  phone          String?
  moduleInterest String?
  message        String?
  consent        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// --- MÃ³dulo 1: AdministraÃ§Ã£o Geral ---

// Cadastro Ãºnico da Prefeitura/Entidade Principal
model Institution {
  id          String   @id @default(cuid())
  name        String
  cnpj        String?
  legalName   String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  phone       String?
  email       String?
  website     String?
  logoUrl     String?
  mayorName   String?
  managerName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// The instance-wide visual layout; institutional identity remains in Institution.
model ReportTemplate {
  id                      String   @id @default(cuid())
  scope                   String   @unique @default("GLOBAL")
  version                 Int      @default(1)
  fingerprint             String   @unique
  header                  String   @default("")
  footer                  String   @default("")
  orientation             String   @default("LANDSCAPE")
  includeEmissionMetadata Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// Secretarias, Autarquias e Fundos
model Secretariat {
  id          String               @id @default(cuid())
  name        String
  acronym     String?
  managerName String?
  departments Department[]
  units       AdministrativeUnit[]
  employees   Employee[]
  demands     InternalDemand[]

  // Mod 6
  portalNews PortalNews[] @relation("NewsSecretariat")

  // Mod 8
  budgetUnits BudgetUnit[] @relation("SecretariatBudgetUnits")
  revenues    Revenue[]    @relation("SecretariatRevenues")
  expenses    Expense[]    @relation("SecretariatExpenses")

  // Mod 9
  purchaseRequests   PurchaseRequest[] @relation("SecretariatPurchaseRequests")
  purchaseProcesses  PurchaseProcess[] @relation("SecretariatPurchaseProcesses")
  contracts          Contract[]        @relation("SecretariatContracts")
  camaraLegislaturas CamLegislatura[]  @relation("CamaraLegislatureSecretariat")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
}

// Departamentos / Setores
model Department {
  id            String           @id @default(cuid())
  name          String
  description   String?
  secretariatId String
  secretariat   Secretariat      @relation(fields: [secretariatId], references: [id], onDelete: Cascade)
  employees     Employee[]
  demands       InternalDemand[]

  // Mod 3
  currentProcesses    Process[]              @relation("CurrentDepartment")
  movementsFrom       ProcessMovement[]      @relation("MovementFrom")
  movementsTo         ProcessMovement[]      @relation("MovementTo")
  dispatches          ProcessDispatch[]      @relation("DispatchDepartment")
  initialProcessTypes ProcessType[]          @relation("ProcessTypeInitialDepartment")
  initialSubjects     Subject[]              @relation("SubjectInitialDepartment")
  processEvents       ProcessEvent[]         @relation("ProcessEventDepartment")
  workflowStages      ProcessWorkflowStage[]
  genericWorkflowStages GenericProcessWorkflowStage[]

  // Mod 4 e 5
  folders                Folder[]            @relation("FolderDepartment")
  tickets                Ticket[]            @relation("TicketDepartment")
  ombudsmans             Ombudsman[]         @relation("OmbudsmanDepartment")
  serviceSubjects        ServiceSubject[]    @relation("ServiceSubjectDepartment")
  ticketMovementsFrom    TicketMovement[]    @relation("TicketMovementFromDepartment")
  ticketMovementsTo      TicketMovement[]    @relation("TicketMovementToDepartment")
  ombudsmanMovementsFrom OmbudsmanMovement[] @relation("OmbudsmanMovementFromDepartment")
  ombudsmanMovementsTo   OmbudsmanMovement[] @relation("OmbudsmanMovementToDepartment")

  // Mod 9
  purchaseRequests PurchaseRequest[] @relation("DepartmentPurchaseRequests")

  // Mod 11
  assets           Asset[]
  transfersFrom    AssetTransfer[]    @relation("TransferFromDept")
  transfersTo      AssetTransfer[]    @relation("TransferToDept")
  materialMoves    MaterialMovement[] @relation("MovementDepartment")
  materialRequests MaterialRequest[]  @relation("MaterialRequestDepartment")
  obrasServices    ObrasServico[]     @relation("ObrasServicoDepartment")
  obrasTeams       ObrasEquipe[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
}

// Unidades Administrativas (Escolas, UBS, CRAS, Almoxarifados)
model AdministrativeUnit {
  id            String      @id @default(cuid())
  name          String
  type          String // e.g., 'Escola', 'UBS', 'CRAS', 'Almoxarifado'
  address       String?
  managerName   String?
  secretariatId String
  secretariat   Secretariat @relation(fields: [secretariatId], references: [id], onDelete: Cascade)
  employees     Employee[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  isActive      Boolean     @default(true)
}

// Cargos e FunÃ§Ãµes
model Role {
  id          String     @id @default(cuid())
  name        String
  description String?
  level       String? // 'Diretor', 'Coordenador', 'Servidor', etc.
  canSign     Boolean    @default(false)
  isActive    Boolean    @default(true)
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// Servidores BÃ¡sicos (Base para RH e vinculaÃ§Ã£o de responsÃ¡veis)
model Employee {
  id              String  @id @default(cuid())
  name            String
  cpf             String? @unique
  registration    String? // MatrÃ­cula
  email           String?
  phone           String?
  isActive        Boolean @default(true)
  salaryBase      Float   @default(0)
  contractedHours Int     @default(220)

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  secretariatId String?
  secretariat   Secretariat? @relation(fields: [secretariatId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  unitId String?
  unit   AdministrativeUnit? @relation(fields: [unitId], references: [id])

  demands        InternalDemand[] @relation("DemandAssignee")
  createdDemands InternalDemand[] @relation("DemandCreator")

  // Mod 3
  usuario                     Usuario?
  processMovements            ProcessMovement[]   @relation("MovementEmployee")
  destinationProcessMovements ProcessMovement[]   @relation("MovementDestinationEmployee")
  receivedProcessMovements    ProcessMovement[]   @relation("MovementReceiverEmployee")
  processDocuments            ProcessDocument[]   @relation("DocumentEmployee")
  processDispatches           ProcessDispatch[]   @relation("DispatchEmployee")
  currentProcesses            Process[]           @relation("CurrentProcessResponsible")
  archivedProcesses           Process[]           @relation("ProcessArchivedBy")
  processEvents               ProcessEvent[]      @relation("ProcessEventEmployee")
  documentSignatures          DocumentSignature[] @relation("DocumentSignatureEmployee")

  // Mod 4 e 5
  tickets               Ticket[]               @relation("TicketAssignee")
  ticketInteractions    TicketInteraction[]    @relation("InteractionEmployee")
  resolvedTickets       Ticket[]               @relation("TicketResolvedBy")
  concludedTickets      Ticket[]               @relation("TicketConcludedBy")
  ticketMovements       TicketMovement[]       @relation("TicketMovementEmployee")
  ticketAudits          TicketAuditLog[]       @relation("TicketAuditEmployee")
  ombudsmanAudits       OmbudsmanAuditLog[]    @relation("OmbudsmanAuditEmployee")
  ticketDocuments       TicketDocument[]       @relation("TicketDocumentEmployee")
  ombudsmanDocuments    OmbudsmanDocument[]    @relation("OmbudsmanDocumentEmployee")
  ombudsmanMovements    OmbudsmanMovement[]    @relation("OmbudsmanMovementEmployee")
  ombudsmanInteractions OmbudsmanInteraction[] @relation("OmbudsmanInteractionEmployee")
  assignedOmbudsmans    Ombudsman[]            @relation("OmbudsmanAssignee")
  respondedOmbudsmans   Ombudsman[]            @relation("OmbudsmanRespondedBy")
  concludedOmbudsmans   Ombudsman[]            @relation("OmbudsmanConcludedBy")

  // Mod 6
  portalPages     PortalPage[]    @relation("PageAuthor")
  portalNews      PortalNews[]    @relation("NewsAuthor")
  officialDiaries OfficialDiary[] @relation("DiaryAuthor")

  // Mod 8
  settlements             Settlement[]             @relation("SettlementAuthor")
  accountingEntries       AccountingEntry[]        @relation("AccountingEntryAuthor")
  financialAuditLogs      FinancialAuditLog[]      @relation("FinancialAuditEmployee")
  taxAuditLogs            TaxAuditLog[]            @relation("TaxAuditEmployee")
  materialMovements       MaterialMovement[]       @relation("MaterialMovementActor")
  accountingTransactions  AccountingTransaction[]  @relation("AccountingTransactionEmployee")
  monthlyAccountingCloses MonthlyAccountingClose[] @relation("MonthlyCloseEmployee")
  annualAccountingCloses  AnnualAccountingClose[]  @relation("AnnualCloseEmployee")

  // Mod 9
  purchaseRequests        PurchaseRequest[] @relation("EmployeePurchaseRequests")
  approvedPurchaseRequests PurchaseRequest[] @relation("PurchaseRequestApprover")
  receivedPurchaseReceipts PurchaseReceipt[] @relation("PurchaseReceiptReceiver")
  attestedPurchaseReceipts PurchaseReceipt[] @relation("PurchaseReceiptAttester")
  managedContracts        Contract[]        @relation("ContractManager")
  inspectedContracts      Contract[]        @relation("ContractInspector")
  camaraCouncilorProfiles CamVereador[]     @relation("CamaraCouncilorEmployee")

  // Mod 10
  personId      String?            @unique
  person        Person?            @relation("PersonEmployee", fields: [personId], references: [id])
  payrolls      PayrollItem[]      @relation("EmployeePayrollItem")
  vacations     Vacation[]         @relation("EmployeeVacation")
  leaves        Leave[]            @relation("EmployeeLeave")
  attendances   AttendanceRecord[] @relation("EmployeeAttendance")
  dependents    Dependent[]        @relation("EmployeeDependent")
  benefits      PayrollBenefit[]   @relation("EmployeeBenefit")
  personnelActs PersonnelAct[]     @relation("EmployeePersonnelAct")

  // Mod 11
  managedWarehouses           Warehouse[]            @relation("WarehouseManager")
  responsibleAssets           Asset[]                @relation("AssetResponsible")
  assetTransfersFrom          AssetTransfer[]        @relation("TransferFromResp")
  assetTransfersTo            AssetTransfer[]        @relation("TransferToResp")
  materialRequests            MaterialRequest[]      @relation("MaterialRequester")
  approvedMaterialRequests    MaterialRequest[]      @relation("MaterialRequestApprover")
  issuedMaterialRequests      MaterialRequest[]      @relation("MaterialRequestIssuer")
  obrasTeamMemberships        ObrasEquipeMembro[]
  obrasServiceAssignments     ObrasServicoEmployee[]
  culturaSpacesResponsible    CulturaEspaco[]        @relation("CulturaSpaceResponsible")
  culturaEventsResponsible    CulturaEvento[]        @relation("CulturaEventResponsible")
  culturaActivitiesInstructor CulturaAtividade[]     @relation("CulturaActivityInstructor")
  segurancaGuardaProfiles     SegurancaGuarda[]      @relation("SegurancaGuardaEmployee")

  // Mod 12
  directedSchools School[] @relation("SchoolDirector")
  teacher         Teacher? @relation("EmployeeTeacher")

  // Mod 13
  healthProfessional HealthProfessional? @relation("EmployeeHealthProfessional")
  managedHealthUnits HealthUnit[]        @relation("HealthUnitManager")

  // Mod 14
  managedSocialUnits SocialUnit[]              @relation("SocialUnitManager")
  socialAttendances  SocialAttendance[]        @relation("SocialAttendanceProfessional")
  socialVisits       SocialVisit[]             @relation("SocialVisitProfessional")
  socialConcessions  SocialBenefitConcession[] @relation("SocialConcessionProfessional")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Demandas Administrativas Internas
model InternalDemand {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("Aberta") // Aberta, Em andamento, ConcluÃ­da, etc.
  priority    String    @default("Normal") // Baixa, Normal, Alta, Urgente
  deadline    DateTime?

  secretariatId String?
  secretariat   Secretariat? @relation(fields: [secretariatId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  assigneeId String?
  assignee   Employee? @relation("DemandAssignee", fields: [assigneeId], references: [id])

  creatorId String?
  creator   Employee? @relation("DemandCreator", fields: [creatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// CalendÃ¡rio Institucional
model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  isHoliday   Boolean  @default(false)
  type        String // 'Feriado Nacional', 'Ponto Facultativo', 'Expediente Especial'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- MÃ³dulo 2: Cadastros Gerais ---

// Pessoas FÃ­sicas
model Person {
  id             String    @id @default(cuid())
  fullName       String
  socialName     String?
  cpf            String    @unique
  rg             String?
  rgIssuer       String?
  birthDate      DateTime?
  gender         String?
  nationality    String?
  birthPlace     String?
  maritalStatus  String?
  profession     String?
  educationLevel String?
  motherName     String?
  fatherName     String?
  status         String    @default("Ativo") // Ativo, Inativo

  // Contatos
  phonePrimary   String?
  phoneSecondary String?
  whatsapp       String?
  email          String?
  emailSecondary String?

  // Relacionamentos
  addresses               Address[]
  taxpayerInfo            Taxpayer?
  supplierInfo            Supplier?
  creditorInfo            Creditor?
  legalRepresentations    LegalRepresentative[] @relation("RepresentedPerson")
  representedBy           LegalRepresentative[] @relation("RepresentativePerson")
  documents               Document[]
  camaraCouncilorProfiles CamVereador[]         @relation("CamaraCouncilorPerson")

  // Mod 3
  processes Process[]

  // Mod 4 e 5
  tickets             Ticket[]
  ombudsmans          Ombudsman[]
  ombudsmanIdentities OmbudsmanIdentity[]

  // Mod 10
  dependents Dependent[] @relation("PersonDependent")
  employee   Employee?   @relation("PersonEmployee")

  // Mod 12
  studentInfo Student?              @relation("StudentPerson")
  guardianFor EducationalGuardian[] @relation("GuardianPerson")

  // Mod 13
  patientInfo Patient? @relation("PersonPatient")

  // Mod 14
  socialFamily       SocialFamily?             @relation("FamilyRepresentative")
  socialFamilyMember SocialFamilyMember?       @relation("FamilyMemberPerson")
  socialAttendances  SocialAttendance[]
  socialConcessions  SocialBenefitConcession[]

  culturaAgents       CulturaAgente[]  @relation("CulturaAgentPerson")
  culturaReservations CulturaReserva[] @relation("CulturaReservationPerson")
  mergeSourceRequests PersonMergeRequest[] @relation("PersonMergeSource")
  mergeTargetRequests PersonMergeRequest[] @relation("PersonMergeTarget")
  mergeSourceLedger   PersonMergeLedger[]  @relation("PersonMergeLedgerSource")
  mergeTargetLedger   PersonMergeLedger[]  @relation("PersonMergeLedgerTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Pessoas JurÃ­dicas
model Company {
  id             String    @id @default(cuid())
  corporateName  String
  tradeName      String?
  cnpj           String    @unique
  municipalInsc  String?
  stateInsc      String?
  companyType    String? // MEI, ME, EPP, LTDA, SA, etc.
  legalNature    String?
  primaryCnae    String?
  secondaryCnaes String?
  openingDate    DateTime?
  taxRegime      String?
  status         String    @default("Ativo") // Ativo, Inativo

  // Contatos
  phone         String?
  whatsapp      String?
  emailPrimary  String?
  emailFiscal   String?
  website       String?
  contactPerson String?

  // Relacionamentos
  addresses       Address[]
  taxpayerInfo    Taxpayer?
  supplierInfo    Supplier?
  creditorInfo    Creditor?
  representatives LegalRepresentative[] @relation("RepresentedCompany")
  documents       Document[]

  // Mod 3
  processes Process[]

  // Mod 4 e 5
  tickets Ticket[]

  culturaAgents       CulturaAgente[]  @relation("CulturaAgentCompany")
  culturaReservations CulturaReserva[] @relation("CulturaReservationCompany")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Contribuintes
model Taxpayer {
  id                 String  @id @default(cuid())
  taxpayerType       String // PF ou PJ
  municipalInsc      String? @unique
  status             String  @default("Ativo")
  economicActivities String?
  fiscalNotes        String?

  personId String? @unique
  person   Person? @relation(fields: [personId], references: [id], onDelete: Cascade)

  companyId String?  @unique
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  realEstates               RealEstate[]
  economicRegistrations     EconomicRegistration[]
  taxAssessments            TaxAssessment[]
  licenses                  License[]
  debtInstallments          DebtInstallment[]
  activeDebts               ActiveDebt[]
  taxCertificates           TaxCertificate[]
  infractions               Infraction[]
  taxServiceRequests        TaxServiceRequest[]
  taxDeclarations           TaxDeclaration[]
  taxCaseLinks              TaxCaseLink[]
  taxCertificateEvaluations TaxCertificateEvaluation[]
  providedInvoices          Invoice[]                  @relation("InvoiceProvider")
  takenInvoices             Invoice[]                  @relation("InvoiceTaker")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Fornecedores
model Supplier {
  id                       String    @id @default(cuid())
  category                 String?
  businessBranch           String?
  bankData                 String?
  certificationsValidUntil DateTime?
  status                   String    @default("Ativo") // Ativo, Suspenso, Inativo
  notes                    String?

  personId String? @unique
  person   Person? @relation(fields: [personId], references: [id], onDelete: Cascade)

  companyId String?  @unique
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Mod 8
  commitments Commitment[] @relation("SupplierCommitments")
  payments    Payment[]    @relation("SupplierPayments")
  expenses    Expense[]    @relation("SupplierExpenses")
  creditor    Creditor?    @relation("SupplierCreditor")

  // Mod 9
  priceQuotes       PriceQuote[]        @relation("SupplierPriceQuotes")
  contracts         Contract[]          @relation("SupplierContracts")
  directContracting DirectContracting[] @relation("SupplierDirectContracting")

  // Mod 11
  assets            Asset[]            @relation("AssetSupplier")
  assetMaintenances AssetMaintenance[] @relation("AssetMaintenanceSupplier")
  materialMovements MaterialMovement[] @relation("MaterialMovementSupplier")

  // Mod 10
  benefitConfigs BenefitConfig[] @relation("SupplierBenefitConfig")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Representantes Legais
model LegalRepresentative {
  id                 String    @id @default(cuid())
  representationType String // Procurador, SÃ³cio, Contador, Pai, MÃ£e
  startDate          DateTime?
  endDate            DateTime?
  grantedPowers      String?
  status             String    @default("Ativo")
  notes              String?

  // Quem estÃ¡ sendo representado
  representedPersonId String?
  representedPerson   Person? @relation("RepresentedPerson", fields: [representedPersonId], references: [id])

  representedCompanyId String?
  representedCompany   Company? @relation("RepresentedCompany", fields: [representedCompanyId], references: [id])

  // Quem Ã© o representante (sempre uma pessoa fÃ­sica na maioria dos casos)
  representativeId String
  representative   Person @relation("RepresentativePerson", fields: [representativeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// EndereÃ§os
model Address {
  id             String  @id @default(cuid())
  zipCode        String?
  streetName     String?
  number         String?
  complement     String?
  referencePoint String?
  addressType    String? // Residencial, Comercial, CorrespondÃªncia
  zone           String? // Urbana, Rural
  latitude       Float?
  longitude      Float?

  neighborhoodId String?
  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id])

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Mod 12
  school School? @relation("SchoolAddress")

  // Mod 13
  healthUnit HealthUnit? @relation("HealthUnitAddress")

  // Mod 14
  socialUnit     SocialUnit?    @relation("SocialUnitAddress")
  socialFamilies SocialFamily[] @relation("FamilyAddress")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Bairros / Localidades
model Neighborhood {
  id          String  @id @default(cuid())
  name        String
  type        String // Bairro, Distrito, Povoado
  city        String
  state       String
  adminRegion String?
  notes       String?

  addresses   Address[]
  streets     Street[]
  realEstates RealEstate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Logradouros
model Street {
  id      String  @id @default(cuid())
  name    String
  type    String // Rua, Avenida, PraÃ§a
  zipCode String?
  city    String
  state   String
  status  String  @default("Ativo")

  neighborhoodId String?
  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ImÃ³veis
model RealEstate {
  id            String  @id @default(cuid())
  municipalInsc String? @unique
  registration  String? // MatrÃ­cula
  propertyType  String? // Casa, Terreno, Apartamento, GalpÃ£o
  status        String  @default("Regular")

  // EndereÃ§o do imÃ³vel (pode ser diferente do endereÃ§o do contribuinte)
  streetName String?
  number     String?
  complement String?
  lot        String?
  block      String?

  landArea    Float?
  builtArea   Float?
  propertyUse String? // Residencial, Comercial, Misto
  fiscalZone  String?

  neighborhoodId String?
  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id])

  taxpayerId String?
  taxpayer   Taxpayer? @relation(fields: [taxpayerId], references: [id])

  taxAssessments  TaxAssessment[]
  taxDeclarations TaxDeclaration[]
  valuations      PropertyValuation[]

  assets           Asset[]
  schools          School[]
  socialUnits      SocialUnit[]
  culturaSpaces    CulturaEspaco[]     @relation("CulturaSpaceRealEstate")
  culturaHeritages CulturaPatrimonio[] @relation("CulturaHeritageRealEstate")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Documentos e Anexos
model DocumentClass {
  id              String     @id @default(cuid())
  code            String     @unique
  label           String
  signaturePolicy String     @default("EXTERNAL_PROVIDER_REQUIRED") // INTERNAL_ALLOWED, ICP_REQUIRED, EXTERNAL_PROVIDER_REQUIRED
  isActive        Boolean    @default(true)
  documents       Document[]
  genericWorkflowRequiredStages GenericProcessWorkflowStage[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Document {
  id           String    @id @default(cuid())
  title        String
  documentType String // RG, CPF, CNPJ, Contrato, Comprovante
  fileUrl      String
  validUntil   DateTime?
  status       String    @default("VÃ¡lido") // VÃ¡lido, Vencido, Pendente
  notes        String?
  documentClassId String?
  documentClass   DocumentClass? @relation(fields: [documentClassId], references: [id], onDelete: Restrict)
  publicLabel     String         @default("Documento autenticado")
  retentionMonths Int            @default(60)

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  folderId String?
  folder   Folder? @relation("DocumentFolder", fields: [folderId], references: [id])

  obrasServiceLinks            ObrasServicoDocumento[]
  culturaEventLinks            CulturaEventoDocumento[]      @relation("CulturaEventDocument")
  culturaProjectLinks          CulturaProjetoDocumento[]     @relation("CulturaProjectDocument")
  culturaReservationLinks      CulturaReservaDocumento[]     @relation("CulturaReservationDocument")
  culturaCouncilLinks          CulturaConselhoDocumento[]    @relation("CulturaCouncilDocument")
  camaraLegislativeLinks       CamDocumentoLegislativo[]     @relation("CamaraLegislativeDocument")
  segurancaRegistros           SegurancaMobilidadeRegistro[] @relation("SegurancaRegistroDocument")
  settlementDocuments          Settlement[]                  @relation("SettlementDocument")
  purchaseReceiptDocuments     PurchaseReceipt[]             @relation("PurchaseReceiptDocument")
  withholdingReceipts          WithholdingPayable[]          @relation("WithholdingReceiptDocument")
  taxGuideDocuments            TaxGuide[]                    @relation("TaxGuideDocument")
  taxPaymentProofs             TaxPayment[]                  @relation("TaxPaymentProofDocument")
  taxServiceRequests           TaxServiceRequest[]
  taxCaseLinks                 TaxCaseLink[]
  processDocuments             ProcessDocument[]
  ticketLinks                  TicketDocument[]
  ombudsmanLinks               OmbudsmanDocument[]
  multiYearPlanLegalEvidence   MultiYearPlan[]               @relation("MultiYearPlanLegalEvidence")
  budgetGuidelineLegalEvidence BudgetGuideline[]             @relation("BudgetGuidelineLegalEvidence")
  annualBudgetLawLegalEvidence AnnualBudgetLaw[]             @relation("AnnualBudgetLawLegalEvidence")
  creditRequestLegalEvidence   CreditRequest[]               @relation("CreditRequestLegalEvidence")
  versions                     DocumentVersion[]
  signatures                   DocumentSignature[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  taxCertificates TaxCertificate[]
}

// Versoes finalizadas sao snapshots imutaveis do arquivo usado em uma assinatura.
model DocumentVersion {
  id            String    @id @default(cuid())
  documentId    String
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Restrict)
  versionNumber Int
  fileUrl       String
  hashSha256    String
  status        String    @default("FINAL") // FINAL, SIGNED, SUPERSEDED, CANCELLED
  lockedAt      DateTime?
  finalizedAt   DateTime  @default(now())
  publicValidationCode String? @unique
  createdAt     DateTime  @default(now())

  signatures DocumentSignature[]

  @@unique([documentId, versionNumber])
  @@index([documentId, status])
  @@index([hashSha256])
}

// Manifestacoes sao registradas no documento, nunca em um modulo especifico.
model DocumentSignature {
  id                String          @id @default(cuid())
  documentId        String
  document          Document        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  signerUsuarioId  String
  signerUsuario    Usuario   @relation("DocumentSignatureUsuario", fields: [signerUsuarioId], references: [id], onDelete: Restrict)
  signerEmployeeId String?
  signerEmployee   Employee? @relation("DocumentSignatureEmployee", fields: [signerEmployeeId], references: [id], onDelete: SetNull)
  signerName       String
  signerEmail      String

  signatureType        String    @default("SIGN")
  provider             String    @default("INTERNAL")
  isRequired           Boolean   @default(true)
  requestedByUsuarioId String?
  requestedByUsuario   Usuario?  @relation("DocumentSignatureRequestedBy", fields: [requestedByUsuarioId], references: [id], onDelete: Restrict)
  authenticationMethod String
  reauthenticatedAt    DateTime?
  documentHash         String
  verificationCode     String    @unique
  status               String    @default("PENDING") // PENDING, SIGNED, REJECTED, CANCELLED
  requestedAt          DateTime  @default(now())
  signedAt             DateTime?
  rejectedAt           DateTime?
  cancelledAt          DateTime?
  ipAddress            String?
  userAgent            String?
  metadata             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([documentVersionId, signerUsuarioId])
  @@index([documentId, status])
  @@index([signerUsuarioId, createdAt])
}

// --- MÃ³dulo 3: Protocolos e Processos ---

// Tipo de Processo
model ProcessType {
  id                    String      @id @default(cuid())
  name                  String // AlvarÃ¡, LicenÃ§a, CertidÃ£o, OfÃ­cio...
  description           String?
  isActive              Boolean     @default(true)
  initialDepartmentId   String?
  initialDepartment     Department? @relation("ProcessTypeInitialDepartment", fields: [initialDepartmentId], references: [id])
  defaultSlaDays        Int?
  defaultPriority       String?
  requiresInterested    Boolean     @default(false)
  allowsInternalOpening Boolean     @default(true)
  genericWorkflowEnabled Boolean    @default(false)

  subjects       Subject[]
  processes      Process[]
  workflowStages ProcessWorkflowStage[]
  genericWorkflowDefinitions GenericProcessWorkflowDefinition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Assunto do Processo (vinculado a um Tipo)
model Subject {
  id                    String      @id @default(cuid())
  name                  String
  description           String?
  processTypeId         String
  processType           ProcessType @relation(fields: [processTypeId], references: [id], onDelete: Cascade)
  slaDays               Int? // Prazo padrÃ£o em dias para conclusÃ£o
  isActive              Boolean     @default(true)
  initialDepartmentId   String?
  initialDepartment     Department? @relation("SubjectInitialDepartment", fields: [initialDepartmentId], references: [id])
  defaultPriority       String?
  requiresInterested    Boolean     @default(false)
  allowsInternalOpening Boolean     @default(true)

  processes      Process[]
  workflowStages ProcessWorkflowStage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Processo / Protocolo Principal
model Process {
  id             String  @id @default(cuid())
  protocolNumber String  @unique // ex: 2026/00001
  status         String  @default("Aberto") // Aberto, Em AnÃ¡lise, ConcluÃ­do, Arquivado
  description    String?
  priority       String  @default("Normal") // Normal, Alta, Urgente

  processTypeId String
  processType   ProcessType @relation(fields: [processTypeId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  // Interessado (CidadÃ£o ou Empresa)
  personId  String?
  person    Person?  @relation(fields: [personId], references: [id])
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  // Setor atual onde o processo estÃ¡
  currentDepartmentId          String?
  currentDepartment            Department?           @relation("CurrentDepartment", fields: [currentDepartmentId], references: [id])
  currentResponsibleEmployeeId String?
  currentResponsibleEmployee   Employee?             @relation("CurrentProcessResponsible", fields: [currentResponsibleEmployeeId], references: [id])
  expectedCompletionAt         DateTime?
  receivedAt                   DateTime?
  completedAt                  DateTime?
  archivedAt                   DateTime?
  archiveReason                String?
  archivedByEmployeeId         String?
  archivedByEmployee           Employee?             @relation("ProcessArchivedBy", fields: [archivedByEmployeeId], references: [id])
  currentWorkflowStageId       String?
  currentWorkflowStage         ProcessWorkflowStage? @relation("CurrentWorkflowStage", fields: [currentWorkflowStageId], references: [id])

  movements            ProcessMovement[]
  documents            ProcessDocument[]
  dispatches           ProcessDispatch[]
  events               ProcessEvent[]
  notifications        ProtocolNotification[]
  financialCommitments Commitment[]           @relation("FinancialCommitmentProcess")
  taxServiceRequests   TaxServiceRequest[]
  taxCaseLinks         TaxCaseLink[]
  ticket               Ticket?
  ombudsman            Ombudsman?
  genericWorkflowInstance GenericProcessWorkflowInstance?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// TramitaÃ§Ã£o entre setores
model ProcessMovement {
  id        String  @id @default(cuid())
  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  fromDepartmentId String?
  fromDepartment   Department? @relation("MovementFrom", fields: [fromDepartmentId], references: [id])

  toDepartmentId String
  toDepartment   Department @relation("MovementTo", fields: [toDepartmentId], references: [id])

  employeeId String?
  employee   Employee? @relation("MovementEmployee", fields: [employeeId], references: [id]) // Quem encaminhou

  destinationEmployeeId String?
  destinationEmployee   Employee? @relation("MovementDestinationEmployee", fields: [destinationEmployeeId], references: [id])
  receivedByEmployeeId  String?
  receivedByEmployee    Employee? @relation("MovementReceiverEmployee", fields: [receivedByEmployeeId], references: [id])

  reason     String?
  status     String    @default("AWAITING_RECEIPT")
  receivedAt DateTime?
  dueAt      DateTime?
  movedAt    DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
}

// Ordered workflow stages can be configured for a type or overridden by a subject.
model ProcessWorkflowStage {
  id            String      @id @default(cuid())
  processTypeId String
  processType   ProcessType @relation(fields: [processTypeId], references: [id], onDelete: Cascade)
  subjectId     String?
  subject       Subject?    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id])
  position      Int
  slaDays       Int?
  isActive      Boolean     @default(true)
  label         String?
  processes     Process[]   @relation("CurrentWorkflowStage")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([processTypeId, subjectId, position])
  @@index([processTypeId, subjectId, isActive, position])
}

// C2-004 is opt-in only. Existing ProcessWorkflowStage records remain the legacy workflow.
model GenericProcessWorkflowDefinition {
  id                   String    @id @default(cuid())
  processTypeId        String
  processType          ProcessType @relation(fields: [processTypeId], references: [id], onDelete: Restrict)
  version              Int
  status               String    @default("DRAFT") // DRAFT, PUBLISHED
  publishedAt          DateTime?
  publishedByUsuarioId String?
  publishedByUsuario   Usuario?  @relation("GenericWorkflowDefinitionPublisher", fields: [publishedByUsuarioId], references: [id], onDelete: Restrict)
  stages               GenericProcessWorkflowStage[]
  instances            GenericProcessWorkflowInstance[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([processTypeId, version])
  @@index([processTypeId, status])
}

model GenericProcessWorkflowStage {
  id                      String    @id @default(cuid())
  definitionId            String
  definition              GenericProcessWorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  position                Int
  label                   String
  departmentId            String
  department              Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  slaCalendarDays         Int
  requiresSignedDocument  Boolean   @default(false)
  requiredDocumentClassId String?
  requiredDocumentClass   DocumentClass? @relation(fields: [requiredDocumentClassId], references: [id], onDelete: Restrict)
  createdAt               DateTime  @default(now())

  @@unique([definitionId, position])
  @@index([definitionId, position])
}

model GenericProcessWorkflowInstance {
  id                String    @id @default(cuid())
  processId         String    @unique
  process           Process   @relation(fields: [processId], references: [id], onDelete: Restrict)
  definitionId      String
  definition        GenericProcessWorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  definitionVersion Int
  status            String    @default("ACTIVE") // ACTIVE, REJECTED, CONCLUDED
  currentPosition   Int
  dueAt             DateTime?
  instanceTimeZone  String
  openedByUsuarioId String
  openedByUsuario   Usuario   @relation("GenericWorkflowInstanceOpener", fields: [openedByUsuarioId], references: [id], onDelete: Restrict)
  events            GenericProcessWorkflowEvent[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([definitionId])
  @@index([status, dueAt])
}

// This is a separate append-only execution ledger; ProcessEvent remains the legacy timeline.
model GenericProcessWorkflowEvent {
  id             String    @id @default(cuid())
  instanceId     String
  instance       GenericProcessWorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  eventType      String
  fromPosition   Int?
  toPosition     Int?
  actorUsuarioId String
  actorUsuario   Usuario   @relation("GenericWorkflowEventActor", fields: [actorUsuarioId], references: [id], onDelete: Restrict)
  note           String?
  createdAt      DateTime  @default(now())

  @@index([instanceId, createdAt])
}

// Documentos/Anexos do Processo
model ProcessDocument {
  id        String  @id @default(cuid())
  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  // Deprecated after GED consolidation. Kept nullable for an additive rollout.
  title        String?
  fileUrl      String?
  documentType String?
  documentId   String?
  document     Document? @relation(fields: [documentId], references: [id])
  purpose      String?

  employeeId String?
  employee   Employee? @relation("DocumentEmployee", fields: [employeeId], references: [id]) // Quem anexou

  createdAt DateTime @default(now())

  @@index([documentId])
}

// Despachos e Pareceres
model ProcessDispatch {
  id        String  @id @default(cuid())
  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  content      String
  dispatchType String @default("Despacho") // Despacho, Parecer, DecisÃ£o

  employeeId String
  employee   Employee @relation("DispatchEmployee", fields: [employeeId], references: [id]) // Quem despachou

  departmentId String?
  department   Department? @relation("DispatchDepartment", fields: [departmentId], references: [id]) // Setor no momento do despacho

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProcessEvent {
  id             String      @id @default(cuid())
  processId      String
  process        Process     @relation(fields: [processId], references: [id], onDelete: Cascade)
  eventType      String
  description    String?
  previousStatus String?
  newStatus      String?
  departmentId   String?
  department     Department? @relation("ProcessEventDepartment", fields: [departmentId], references: [id])
  employeeId     String?
  employee       Employee?   @relation("ProcessEventEmployee", fields: [employeeId], references: [id])
  metadata       String?
  createdAt      DateTime    @default(now())

  @@index([processId, createdAt])
  @@index([departmentId, createdAt])
}

model ProtocolNotification {
  id           String    @id @default(cuid())
  userId       String
  user         Usuario   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Kept for existing protocol records. New notifications use the typed entity fields.
  processId    String?
  process      Process?  @relation(fields: [processId], references: [id], onDelete: Cascade)
  sourceModule String    @default("PROCESSOS")
  entityType   String    @default("PROCESS")
  entityId     String
  type         String
  title        String
  message      String
  priority     String    @default("NORMAL")
  dedupeKey    String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([sourceModule, entityType, entityId, createdAt])
  @@index([processId, createdAt])
  @@index([userId, dedupeKey])
}

model ProcessSequence {
  year       Int      @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
}

// --- MÃ³dulo 4: GED (Gerenciamento EletrÃ´nico de Documentos) ---

model Folder {
  id          String  @id @default(cuid())
  name        String
  description String?

  parentId String?
  parent   Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children Folder[] @relation("FolderHierarchy")

  departmentId String?
  department   Department? @relation("FolderDepartment", fields: [departmentId], references: [id])

  documents Document[] @relation("DocumentFolder")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- MÃ³dulo 5: Atendimento e Ouvidoria ---

model SupportChannel {
  id          String  @id @default(cuid())
  name        String // e.g., 'Portal', 'Presencial', 'WhatsApp', 'Telefone'
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  tickets    Ticket[]
  ombudsmans Ombudsman[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model ServiceSubject {
  id                  String      @id @default(cuid())
  name                String      @unique
  description         String?
  defaultDepartmentId String?
  defaultDepartment   Department? @relation("ServiceSubjectDepartment", fields: [defaultDepartmentId], references: [id])
  defaultPriority     String      @default("Normal")
  defaultDueDays      Int?
  isActive            Boolean     @default(true)
  tickets             Ticket[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([isActive, name])
}

model Ticket {
  id           String    @id @default(cuid())
  ticketNumber String    @unique // e.g., TKT-2026-0001
  subject      String
  description  String
  status       String    @default("Aberto") // Aberto, Encaminhado, Aguardando Recebimento, Em Atendimento, Aguardando InformaÃ§Ã£o, Resolvido, ConcluÃ­do, Cancelado, Reaberto
  priority     String    @default("Normal")
  isAnonymous  Boolean   @default(false)
  dueAt        DateTime?
  resolvedAt   DateTime?
  solution     String?
  concludedAt  DateTime?

  channelId String
  channel   SupportChannel @relation(fields: [channelId], references: [id])

  personId  String?
  person    Person?  @relation(fields: [personId], references: [id])
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  departmentId String?
  department   Department? @relation("TicketDepartment", fields: [departmentId], references: [id])

  assigneeId String?
  assignee   Employee? @relation("TicketAssignee", fields: [assigneeId], references: [id])

  serviceSubjectId String?
  serviceSubject   ServiceSubject? @relation(fields: [serviceSubjectId], references: [id])

  resolvedById  String?
  resolvedBy    Employee? @relation("TicketResolvedBy", fields: [resolvedById], references: [id])
  concludedById String?
  concludedBy   Employee? @relation("TicketConcludedBy", fields: [concludedById], references: [id])

  processId String?  @unique
  process   Process? @relation(fields: [processId], references: [id])

  interactions TicketInteraction[]
  movements    TicketMovement[]
  auditLogs    TicketAuditLog[]
  documents    TicketDocument[]
  satisfaction SatisfactionSurvey?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId, status, dueAt])
  @@index([assigneeId, status])
  @@index([serviceSubjectId])
}

model Ombudsman {
  id             String  @id @default(cuid())
  protocolNumber String  @unique
  type           String // DenÃºncia, ReclamaÃ§Ã£o, Elogio, SugestÃ£o
  subject        String
  description    String
  isAnonymous    Boolean @default(false)
  isConfidential Boolean @default(false)
  status         String  @default("Recebida")

  channelId String
  channel   SupportChannel @relation(fields: [channelId], references: [id])

  personId String?
  person   Person? @relation(fields: [personId], references: [id])

  departmentId String?
  department   Department? @relation("OmbudsmanDepartment", fields: [departmentId], references: [id])

  assigneeId    String?
  assignee      Employee? @relation("OmbudsmanAssignee", fields: [assigneeId], references: [id])
  processId     String?   @unique
  process       Process?  @relation(fields: [processId], references: [id])
  response      String?
  respondedAt   DateTime?
  respondedById String?
  respondedBy   Employee? @relation("OmbudsmanRespondedBy", fields: [respondedById], references: [id])
  concludedAt   DateTime?
  concludedById String?
  concludedBy   Employee? @relation("OmbudsmanConcludedBy", fields: [concludedById], references: [id])

  accessGrants OmbudsmanAccess[]
  auditLogs    OmbudsmanAuditLog[]
  identity     OmbudsmanIdentity?
  movements    OmbudsmanMovement[]
  interactions OmbudsmanInteraction[]
  documents    OmbudsmanDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId, status])
  @@index([isConfidential, createdAt])
}

model TicketInteraction {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  message    String
  type       String  @default("Registro") // Registro, ComentÃ¡rio, Encaminhamento, AssunÃ§Ã£o, Resposta, SolicitaÃ§Ã£o de InformaÃ§Ã£o, SoluÃ§Ã£o, ConclusÃ£o, Reabertura
  isInternal Boolean @default(false)

  employeeId String?
  employee   Employee? @relation("InteractionEmployee", fields: [employeeId], references: [id])

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model TicketDocument {
  id         String    @id @default(cuid())
  ticketId   String
  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  documentId String
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Restrict)
  employeeId String?
  employee   Employee? @relation("TicketDocumentEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  purpose    String?
  createdAt  DateTime  @default(now())

  @@unique([ticketId, documentId])
  @@index([documentId])
}

model TicketMovement {
  id               String      @id @default(cuid())
  ticketId         String
  ticket           Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromDepartmentId String?
  fromDepartment   Department? @relation("TicketMovementFromDepartment", fields: [fromDepartmentId], references: [id])
  toDepartmentId   String
  toDepartment     Department  @relation("TicketMovementToDepartment", fields: [toDepartmentId], references: [id])
  fromAssigneeId   String?
  toAssigneeId     String?
  employeeId       String
  employee         Employee    @relation("TicketMovementEmployee", fields: [employeeId], references: [id])
  reason           String
  createdAt        DateTime    @default(now())

  @@index([ticketId, createdAt])
  @@index([toDepartmentId, createdAt])
}

model TicketAuditLog {
  id         String    @id @default(cuid())
  ticketId   String
  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId     String
  user       Usuario   @relation("TicketAuditUsuario", fields: [userId], references: [id])
  employeeId String?
  employee   Employee? @relation("TicketAuditEmployee", fields: [employeeId], references: [id])
  action     String
  details    Json?
  createdAt  DateTime  @default(now())

  @@index([ticketId, createdAt])
}

model OmbudsmanAccess {
  id              String    @id @default(cuid())
  ombudsmanId     String
  ombudsman       Ombudsman @relation(fields: [ombudsmanId], references: [id], onDelete: Cascade)
  userId          String
  user            Usuario   @relation("OmbudsmanAccessUsuario", fields: [userId], references: [id], onDelete: Cascade)
  grantedById     String
  grantedBy       Usuario   @relation("OmbudsmanAccessGrantedBy", fields: [grantedById], references: [id])
  canViewIdentity Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@unique([ombudsmanId, userId])
  @@index([userId])
}

// Identifying data is isolated from the manifestation content for new records.
model OmbudsmanIdentity {
  id          String    @id @default(cuid())
  ombudsmanId String    @unique
  ombudsman   Ombudsman @relation(fields: [ombudsmanId], references: [id], onDelete: Cascade)
  personId    String
  person      Person    @relation(fields: [personId], references: [id])
  createdAt   DateTime  @default(now())
}

model OmbudsmanMovement {
  id               String      @id @default(cuid())
  ombudsmanId      String
  ombudsman        Ombudsman   @relation(fields: [ombudsmanId], references: [id], onDelete: Cascade)
  fromDepartmentId String?
  fromDepartment   Department? @relation("OmbudsmanMovementFromDepartment", fields: [fromDepartmentId], references: [id])
  toDepartmentId   String
  toDepartment     Department  @relation("OmbudsmanMovementToDepartment", fields: [toDepartmentId], references: [id])
  employeeId       String
  employee         Employee    @relation("OmbudsmanMovementEmployee", fields: [employeeId], references: [id])
  reason           String
  createdAt        DateTime    @default(now())

  @@index([ombudsmanId, createdAt])
  @@index([toDepartmentId, createdAt])
}

model OmbudsmanInteraction {
  id          String    @id @default(cuid())
  ombudsmanId String
  ombudsman   Ombudsman @relation(fields: [ombudsmanId], references: [id], onDelete: Cascade)
  type        String
  message     String
  isInternal  Boolean   @default(true)
  employeeId  String?
  employee    Employee? @relation("OmbudsmanInteractionEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([ombudsmanId, createdAt])
}

model OmbudsmanDocument {
  id          String    @id @default(cuid())
  ombudsmanId String
  ombudsman   Ombudsman @relation(fields: [ombudsmanId], references: [id], onDelete: Cascade)
  documentId  String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Restrict)
  employeeId  String?
  employee    Employee? @relation("OmbudsmanDocumentEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  purpose     String?
  createdAt   DateTime  @default(now())

  @@unique([ombudsmanId, documentId])
  @@index([documentId])
}

model OmbudsmanAuditLog {
  id          String    @id @default(cuid())
  ombudsmanId String
  ombudsman   Ombudsman @relation(fields: [ombudsmanId], references: [id], onDelete: Cascade)
  userId      String
  user        Usuario   @relation("OmbudsmanAuditUsuario", fields: [userId], references: [id])
  employeeId  String?
  employee    Employee? @relation("OmbudsmanAuditEmployee", fields: [employeeId], references: [id])
  action      String
  details     Json?
  createdAt   DateTime  @default(now())

  @@index([ombudsmanId, createdAt])
}

model SatisfactionSurvey {
  id       String @id @default(cuid())
  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  rating   Int // 1 to 5
  comments String?

  createdAt DateTime @default(now())
}

// --- MÃ³dulo 6: Portal e TransparÃªncia ---

