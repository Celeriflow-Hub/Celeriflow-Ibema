  budgetUnitId                  String
  budgetUnit                    BudgetUnit                   @relation(fields: [budgetUnitId], references: [id])
  expenseNatureId               String
  expenseNature                 ExpenseNature                @relation(fields: [expenseNatureId], references: [id])
  resourceSourceId              String
  resourceSource                ResourceSource               @relation(fields: [resourceSourceId], references: [id])
  annualBudgetExpenseFixationId String?
  annualBudgetExpenseFixation   AnnualBudgetExpenseFixation? @relation(fields: [annualBudgetExpenseFixationId], references: [id], onDelete: Restrict)
  programPPAId                  String?
  programPPA                    ProgramPPA?                  @relation("BudgetAppropriationProgram", fields: [programPPAId], references: [id], onDelete: Restrict)
  actionPPAId                   String?
  actionPPA                     ActionPPA?                   @relation("BudgetAppropriationAction", fields: [actionPPAId], references: [id], onDelete: Restrict)
  initialValue                  Float                        @default(0)
  initialValueDecimal           Decimal?                     @db.Decimal(18, 2)
  updatedValue                  Float                        @default(0)
