  statementItems       BankStatementItem[]
  covenants            Covenant[]
  investmentAllocationsAsOrigin InvestmentAllocation[] @relation("InvestmentAllocationOrigin")
  investmentAllocationsAsInvestment InvestmentAllocation[] @relation("InvestmentAllocationInvestment")
}

model TreasuryMovement {
